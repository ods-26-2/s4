# Exemplo de configuracao para rodar o S4 na Jetson via docker compose.
# Copie para .env (fora do git) e preencha com os dados da equipe de integracao.

# Diretorio no NVMe da Jetson onde ficam SQLite, clipes e log de expurgo.
ODS_S4_DATA_DIR=/mnt/nvme/s4

# Barramento B3 da equipe de integracao.
ODS_S4_KAFKA_BROKERS=200.17.66.56:9093
ODS_S4_KAFKA_GROUP_ID=s4-media-evidence
ODS_S4_KAFKA_CLIENT_ID=s4

# Seguranca opcional do Kafka (repassada ao librdkafka).
ODS_S4_KAFKA_SECURITY_PROTOCOL=
ODS_S4_KAFKA_SASL_MECHANISM=
ODS_S4_KAFKA_SASL_USERNAME=
ODS_S4_KAFKA_SASL_PASSWORD=
ODS_S4_KAFKA_SSL_CA_LOCATION=

# Fonte de video. Deixe as duas vazias para subir com a fonte sintetica
# (apenas demo da API). Para integrar de verdade, escolha UMA:
#   ODS_S4_P4_SHM=/ipc/ods_p4_cam0   (quadros crus do P4 via shmsink)
#   ODS_S4_SOURCE=/app/video_test/algum.mp4  (replay de um MP4 local)
ODS_S4_SOURCE=
ODS_S4_P4_SHM=
ODS_S4_WIDTH=1280
ODS_S4_HEIGHT=720
ODS_S4_FPS=30

# Diretorio da Jetson que contem o socket do P4. Ele e montado em /ipc no
# container; o valor de ODS_S4_P4_SHM deve usar esse caminho interno.
ODS_S4_IPC_DIR=/tmp

# CORS da API HTTP. "*" atende a rede interna; restrinja se necessario.
ODS_S4_CORS_ORIGIN=*
